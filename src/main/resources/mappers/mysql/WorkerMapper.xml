<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zawzaw.worktime.mapper.WorkerMapper">
	<resultMap type="com.zawzaw.worktime.model.entity.EWorker" id="workerResultMap">
		<result column="worker_no" property="workerNo"/>
		<result column="name" property="name"/>
		<result column="email" property="email"/>
		<result column="password" property="password"/>
	</resultMap>
	<select id="findByWorkerNo"
			parameterType="string"
			resultMap="workerResultMap">
		SELECT
			id,
			worker_no,
			name,
			email,
			password
		FROM worker
		WHERE worker_no = #{workerNo}
	</select>
</mapper>